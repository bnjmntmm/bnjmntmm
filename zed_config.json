// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "notification_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [],
  },
  "terminal": {
    "font_family": "MesloLGMDZ Nerd Font",
    "blinking": "on",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "minimap": {
    "show": "auto",
  },
  "cursor_blink": true,
  "file_types": {
    "tailwindcss": [
      "*.css",
      "*.css"
    ],
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Atom One Dark",
  },
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.3-codex",
    },
  },
  "buffer_font_size": 14,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "tab_size": 4,
  "tabs": { "git_status": true, "file_icons": true },
  "tab_bar": { "show_nav_history_buttons": true },
  "show_whitespaces": "selection",
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "left",
  },
  "ui_font_size": 16,
  "ui_font_weight": 400,
}
